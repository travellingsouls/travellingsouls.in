# ---------------------------------------------------------------------------
# TravellingSouls — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# Supabase — project URL and public anon key.
# Safe to expose to the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — service role key. SERVER ONLY.
# Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Never import this into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site origin. No trailing slash.
# Used for metadataBase, canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number in international format, digits only.
# Example for India: 91XXXXXXXXXX
# TODO: replace with the real TravellingSouls WhatsApp number.
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
